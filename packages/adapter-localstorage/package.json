{
  "name": "@instafix/adapter-localstorage",
  "version": "0.5.4",
  "private": true,
  "description": "localStorage adapter for InstaFix — client-side feedback persistence without a server. Internal: powers the docs site's own embedded widget instance; not a supported install target for consumers.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/fix-dts.mjs dist",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "instafix",
    "localstorage",
    "adapter",
    "feedback",
    "client-side",
    "no-server",
    "demo",
    "typescript"
  ],
  "author": "gnoopy",
  "license": "MIT",
  "homepage": "https://instafix.realstory.blog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnoopy/instafix.git",
    "directory": "packages/adapter-localstorage"
  },
  "bugs": {
    "url": "https://github.com/gnoopy/instafix/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@instafix/core": "workspace:*"
  }
}
