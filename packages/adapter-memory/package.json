{
  "name": "@instafix/adapter-memory",
  "version": "0.5.4",
  "private": true,
  "description": "In-memory adapter for InstaFix — zero dependencies, works everywhere. Internal: powers apps/demo's live public /demo backend (auto-resets every 10 minutes); not a supported install target for consumers.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/fix-dts.mjs dist",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "instafix",
    "memory",
    "adapter",
    "feedback",
    "testing",
    "demo",
    "typescript"
  ],
  "author": "gnoopy",
  "license": "MIT",
  "homepage": "https://instafix.realstory.blog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnoopy/instafix.git",
    "directory": "packages/adapter-memory"
  },
  "bugs": {
    "url": "https://github.com/gnoopy/instafix/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@instafix/core": "workspace:*"
  }
}
