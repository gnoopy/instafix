{
  "name": "@instafix/core",
  "version": "0.7.2",
  "private": true,
  "description": "Shared types and schema definitions for @instafix packages",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "default": "./src/testing.ts"
    }
  },
  "author": "gnoopy",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://instafix.realstory.blog",
  "bugs": {
    "url": "https://github.com/gnoopy/instafix/issues"
  },
  "keywords": [
    "instafix",
    "types",
    "schema",
    "feedback"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnoopy/instafix.git",
    "directory": "packages/core"
  }
}
