{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-notes-type": "github",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "test",
      "section": "Tests"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "chore",
      "section": "Miscellaneous"
    }
  ],
  "packages": {
    "packages/widget": {
      "release-type": "node",
      "component": "widget",
      "bump-minor-pre-major": true
    },
    "packages/dashboard": {
      "release-type": "node",
      "component": "dashboard",
      "bump-minor-pre-major": true
    },
    "packages/cli": {
      "release-type": "node",
      "component": "cli",
      "bump-minor-pre-major": true,
      "extra-files": ["src/version.ts"]
    },
    "packages/adapter-sqlite": {
      "release-type": "node",
      "component": "adapter-sqlite",
      "bump-minor-pre-major": true
    },
    "packages/adapter-fs": {
      "release-type": "node",
      "component": "adapter-fs",
      "bump-minor-pre-major": true
    }
  }
}
