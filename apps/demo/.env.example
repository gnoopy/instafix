# Database URL for Prisma (required for the demo with real database)
# DATABASE_URL="postgresql://user:password@localhost:5432/instafix"

# The demo runs with an in-memory store by default — no database required.
# To use a real database, uncomment DATABASE_URL and configure Prisma.

# Shared password for the /admin contact-message inbox (문의하기 submissions).
# Required to log in at /admin/login — leave unset to disable admin login.
# ADMIN_PASSWORD="change-me"
