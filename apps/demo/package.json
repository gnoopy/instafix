{
  "name": "@instafix/demo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "fumadocs-mdx && next dev --turbopack",
    "build": "fumadocs-mdx && next build && node scripts/sync-standalone-assets.mjs",
    "start": "next start",
    "check": "fumadocs-mdx && tsc --noEmit",
    "clean": "rm -rf .next"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@instafix/adapter-localstorage": "workspace:*",
    "@instafix/adapter-memory": "workspace:*",
    "@instafix/adapter-sqlite": "workspace:*",
    "@instafix/dashboard": "workspace:*",
    "@instafix/widget": "workspace:*",
    "gsap": "^3.15.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "fumadocs-core": "^16.15.10",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.10"
  },
  "devDependencies": {
    "@instafix/core": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.0.0",
    "@types/mdx": "^2.0.13"
  }
